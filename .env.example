# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

APP_ENV=development

# ---- Gemini (primary provider) ----
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6JiQ-Kx0B8QdFLTqjSBjZMOXgObBG2eoKrTUBvfFcpfFw
# GEMINI_API_KEY=AQ.Ab8RN6JybennazHa1xVpvsl4z_D_HNtcuaDSpRI5JPAUh2acrg

# As of Sep 2026 the free tier covers the current Gemini 3.x Flash family
# (3.8 Flash, 3.7 Flash, 3.6 Flash, 3.5 Flash, 3 Flash Preview, 3.5
# Flash-Lite, 3.1 Flash-Lite) plus the legacy Gemini 2.5 family (Pro/Flash/
# Flash-Lite) — but 2.5 is scheduled to shut down October 16, 2026
# (Developer API), so this project uses the 3.x line already. Pro-tier
# models (e.g. gemini-3.1-pro-preview) left the free tier entirely in
# April 2026. Gemini 2.0 models were already shut down June 1, 2026 — if
# you see a 404 "no longer available" error, that's what happened; check
# https://ai.google.dev/gemini-api/docs/pricing for the current free-tier
# model list and update these four values.
#
# IMPORTANT: Gemini's free-tier daily request quota is tracked per
# (project, model) — e.g. "20 requests/day for gemini-3.6-flash" is a
# SEPARATE bucket from "20 requests/day for gemini-3.5-flash". These four
# are deliberately set to four DIFFERENT models so property_intelligence/
# copywriter (TEXT), vision (VISION), creative_director/blog_seo (FAST),
# and critic (CRITIC) each get their own quota pool instead of stacking
# onto one — vision and critic used to share one bucket (both pointed at
# GEMINI_VISION_MODEL), which is exactly the kind of thing that produces a
# 429 on critic right after vision just succeeded, despite the text/fast
# pools sitting untouched. Don't set these to the same value unless you
# actually want that constraint back.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_CRITIC_MODEL=gemini-3.7-flash

# ---- OpenRouter (fallback provider, optional) ----
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=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
# openrouter/free is OpenRouter's OWN maintained router, not a specific
# model — it randomly selects from whatever's currently free on
# OpenRouter and filters for the capabilities the request needs (image
# understanding, for our vision/critic calls). This is deliberately NOT a
# pinned model slug (e.g. "minimax/minimax-m3:free") — those rotate out
# of the free tier without warning (OpenRouter will 404 with "unavailable
# for free" when it happens, which is exactly what prompted this change),
# and letting OpenRouter pick avoids re-discovering a working slug every
# time one gets discontinued. If you'd rather pin a specific model, verify
# it first at https://openrouter.ai/models?max_price=0. Either way, avoid
# a Google-hosted model here (e.g. any Gemma slug) — OpenRouter's free
# Gemma models route through "Google AI Studio" infrastructure, which can
# share the same congestion/quota as your Gemini primary provider,
# defeating the point of having a fallback at all. Also avoid pinning a
# "reasoning"-branded free model if you see 504 timeouts — they can be
# too slow for the Vision Agent's single batched call covering many
# photos at once (openrouter/free already filters these out reasonably
# well on its own, since it selects for the request's actual needs).
OPENROUTER_MODEL=openrouter/free

# Only used if configs/models.yaml's vision role is switched to
# provider: openrouter (see the comment there) — not read otherwise.
# google/gemma-4-26b-a4b-it:free is a real, current, free multimodal
# model on OpenRouter as of this writing; unlike OPENROUTER_MODEL above,
# this IS a pinned slug rather than OpenRouter's own router, specifically
# because trying a NAMED model is the point of this experiment — check
# https://openrouter.ai/models?max_price=0 if it's since rotated out of
# the free tier.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# ---- Storage ----
DATABASE_PATH=./data/app.db
DATA_DIR=./data

# ---- MLflow ----
# Local SQLite file, no server needed — `mlflow ui --backend-store-uri
# sqlite:///mlflow.db` opens it. NOT "./mlruns": MLflow deprecated that
# file-based backend and it now refuses to initialize by default (raises
# "filesystem tracking backend ... is in maintenance mode"). If you
# already have data in an old ./mlruns folder, migrate it losslessly with
# `mlflow migrate-filestore file-store ./mlruns sqlite:///mlflow.db`
# rather than just switching this value and abandoning it — see
# https://mlflow.org/docs/latest/self-hosting/migrate-from-file-store.
# Generation never depends on this working (every MLflow call is
# defensive — see src/observability/tracing.py), but you'll want your
# traces to actually land somewhere.
# A database URI, not the legacy './mlruns' file store — MLflow
# deprecated that backend and it now refuses to initialize. If this is
# ever pointed at one, tracing falls back to sqlite automatically and
# logs a warning rather than turning itself off (which is what left the
# Workflow Evaluation panel empty).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=agentic-content-platform
MLFLOW_ENABLED=true

# ---- Model gateway ----
# "gemini" or "openrouter"
DEFAULT_MODEL_PROVIDER=gemini

# Seconds to wait between each Vision Agent image call (there's one per
# photo you ingest). Free-tier RPM limits are easy to exceed classifying a
# dozen photos back-to-back in one generation, which cascades into fallback
# rate limits too. Raise this if you still see 429s; set to 0 on a paid tier.
VISION_CALL_DELAY_SECONDS=4.0

# Playwright browser channel for rendering PDFs/screenshots. Leave empty to
# use Playwright's own downloaded Chromium (run `playwright install chromium`
# first). Set to "msedge" (or "chrome") to use an already-installed SYSTEM
# browser instead — no `playwright install` needed for the browser itself.
# Use this if `playwright install chromium` fails with something like
# "Application Control policy has blocked this file" (WDAC/AppLocker on a
# managed Windows machine) — those policies block newly-downloaded/unsigned
# executables but essentially always already allow system Edge.
# Seconds allowed for rendering. Scales with page count and image size.
PLAYWRIGHT_TIMEOUT_SECONDS=300
PLAYWRIGHT_BROWSER_CHANNEL=
# Absolute path to a Chromium/Chrome binary, used INSTEAD of Playwright's
# own download. Two cases need it: a machine whose policy forbids that
# download but already has a managed Chrome, and an environment where
# Playwright's pinned build number and the installed browser disagree
# ("Executable doesn't exist at .../chromium-<n>"). Leave blank normally.
PLAYWRIGHT_CHROMIUM_PATH=

# --- AI image generation ------------------------------------------------
# Leave everything here blank to run with offline placeholder images.
# Missing credentials never break the app; they only turn off generation,
# and the pipelines carry on with the uploaded photos alone.
#
# PRIMARY: Cloudflare Workers AI. Free, no credit card, and the allowance
# renews DAILY rather than being a one-off trial — about 170 FLUX.1-schnell
# images a day on the default Workers Free plan. It runs the same
# FLUX.1-schnell and SDXL weights this project used before, so prompts
# behave the same.
#
# Setup (about two minutes):
#   1. Sign in at https://dash.cloudflare.com  (free account, no card)
#   2. Account ID: it is in the URL after /  — dash.cloudflare.com/<ACCOUNT_ID>
#   3. Token: My Profile -> API Tokens -> Create Token -> Custom token,
#      permission "Account / Workers AI / Read" plus "Edit"
CLOUDFLARE_ACCOUNT_ID=f69a36fcf53d701fd12310a98bec175b
CLOUDFLARE_API_TOKEN=cfat_tewYpUm7EHcS8BV1cWgE6M4KTuAQ7JPGhxPRgBSU7e59eb49
# Tried in order. A request that is not square automatically skips
# flux-1-schnell: that model has no width/height in its API at all and
# would quietly return a square image for a 16:9 hero.
CLOUDFLARE_IMAGE_MODELS=@cf/black-forest-labs/flux-1-schnell,@cf/stabilityai/stable-diffusion-xl-base-1.0

# FALLBACK: OpenRouter, used only when Cloudflare's allowance for the day
# is gone. A different VENDOR rather than another model, because what
# broke the previous setup was an ACCOUNT running out of credit — which no
# amount of model-switching survives. Uses OPENROUTER_API_KEY above.
# Note: image requests here are PAID and need more than $1 of credit;
# with an empty balance the system simply stays on the free provider.
OPENROUTER_IMAGE_MODELS=black-forest-labs/flux-1.1-pro

# auto | cloudflare | openrouter | huggingface | mock | none
# auto = Cloudflare, then OpenRouter, then offline previews.
IMAGE_GEN_PROVIDER=auto
# auto | cgi_render | photograph — match generated images to the medium of
# your own assets. Set cgi_render when the project's images are all 3D
# renders, so an AI lifestyle image doesn't arrive as documentary photography.
IMAGE_GEN_MEDIUM=auto

# HOW LONG TO WAIT FOR AN IMAGE
#
# Two numbers, because they answer different questions.
#
# IMAGE_GEN_TIMEOUT_S is how long ONE request may take. An image model
# thinking for a minute or two is the normal case, not an error, so this is
# generous. (The connect timeout is separate and fixed at 10s: a vendor
# that is DOWN should be noticed in seconds, not minutes.)
#
# IMAGE_GEN_BUDGET_S caps one provider's whole attempt — every model, every
# retry — so a vendor that is simply slow today costs a bounded wait and
# the chain moves on to the other one. Raise it on a slow link; lower it if
# you would rather have the brochure sooner, without its AI illustrations.
#
# Neither is a correctness setting: a timeout costs an illustration, never
# a brochure. The generation finishes from your own photographs and the
# reason is reported on screen.
IMAGE_GEN_TIMEOUT_S=120
IMAGE_GEN_BUDGET_S=210

# Hugging Face Inference Providers. NO LONGER USED BY DEFAULT: this
# account's monthly included credits ran out and every model started
# returning "402 Payment Required". Still selectable with
# IMAGE_GEN_PROVIDER=huggingface if you buy credits or subscribe to PRO;
# "auto" will never pick it, so an exhausted token cannot slow anything down.
HF_TOKEN=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
IMAGE_GEN_MODELS=black-forest-labs/FLUX.1-schnell,stabilityai/stable-diffusion-xl-base-1.0


